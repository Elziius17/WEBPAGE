# =============================================================================
# ELZIIUS — Variables de entorno (plantilla). Copia a .env y completa valores.
# NUNCA subas el archivo .env real al repositorio.
# =============================================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://elziius:elziius_dev@localhost:5432/elziius?schema=public"

# --- Autenticación (Better Auth) ---
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Contacto comercial (no se inventan datos: déjalos vacíos hasta tenerlos) ---
# Número de WhatsApp en formato internacional sin "+" ni espacios, p.ej. 51987654321
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""

# --- Almacenamiento de archivos ---
# driver: "local" (disco, solo desarrollo) o "s3" (S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL pública del bucket para imágenes de productos (opcional)
STORAGE_PUBLIC_URL=""

# --- Seed (usuario administrador inicial) ---
SEED_ADMIN_EMAIL="admin@elziius.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador ELZIIUS"
# "true" para cargar datos de demostración claramente marcados [DEMO]
SEED_DEMO_DATA="true"
